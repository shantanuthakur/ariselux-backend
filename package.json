{
  "name": "ariselux-backend",
  "version": "1.0.0",
  "description": "Backend API service for Ariselux Equipments website",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "build": "node --check src/server.js && node --check src/worker.js",
    "deploy": "wrangler deploy",
    "start": "node src/server.js",
    "dev": "node --watch-path=src src/server.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "morgan": "^1.10.0",
    "multer": "^2.4.0",
    "nodemailer": "^6.10.0"
  },
  "devDependencies": {
    "@cloudflare/containers": "^0.0.23",
    "wrangler": "^4.153.0"
  }
}
