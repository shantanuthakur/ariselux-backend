{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ariselux-backend",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-09",
  "vars": {
    "NODE_ENV": "production",
    "CLIENT_ORIGIN": "https://ariselux.com,https://www.ariselux.com,https://ariselux-frontend.sales3-a0c.workers.dev",
    "COMPANY_EMAIL": "sales3@ariselux.com",
    "COMPANY_PHONE": "+918923730881",
    "SMTP_HOST": "smtp.gmail.com",
    "SMTP_PORT": "587",
    "SMTP_SECURE": "false",
    "FROM_EMAIL": "sales3@ariselux.com"
  },
  "containers": [
    {
      "class_name": "AriseluxBackendContainer",
      "image": "./Dockerfile",
      "max_instances": 3,
      "instance_type": "lite"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "ARISELUX_BACKEND",
        "class_name": "AriseluxBackendContainer"
      }
    ]
  },
  "exports": {
    "AriseluxBackendContainer": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "observability": {
    "enabled": true
  }
}
